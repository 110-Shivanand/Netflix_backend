# ═══════════════════════════════════════════════════════════════
#  Backend Environment Variables — EXAMPLE
#  1. Copy this file:  cp .env.example .env
#  2. Fill in your real values below.
#  3. Never commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────
APP_NAME=Movies API

# development → enables /docs and /redoc
# production  → disables API docs, tighter settings
ENVIRONMENT=development

# ── OMDb API ─────────────────────────────────────────────────
# Get a free key at: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here
OMDB_BASE_URL=http://www.omdbapi.com/

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use * to allow all origins (development only — never in production).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ALLOWED_ORIGINS=*

# ── Docker / uvicorn tuning ──────────────────────────────────
# Port exposed on the host machine  (default: 8000)
API_PORT=8000

# Number of uvicorn worker processes  (default: 4)
# Rule of thumb: 2 × CPU cores + 1
WORKERS=4

# ── Docker resource limits ───────────────────────────────────
# Maximum CPU share allocated to the container  (default: 1.0)
CPU_LIMIT=1.0

# Maximum RAM allocated to the container  (default: 512m)
MEM_LIMIT=512m

# ── Docker Hub (used by docker-compose on EC2) ───────────────
# Set automatically by the CI/CD pipeline; set manually for local
# use if you want to pull from Docker Hub instead of building.
DOCKERHUB_USERNAME=your_dockerhub_username
IMAGE_TAG=latest

# ── Grafana Monitoring ───────────────────────────────────────
# Admin credentials for Grafana dashboard access
# IMPORTANT: Change these in production! Use strong passwords.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Prometheus retention period (default: 30d)
# Examples: 7d, 30d, 90d, 365d
# PROMETHEUS_RETENTION=30d

# ── Notes ────────────────────────────────────────────────────
# Prometheus runs on port 9090 (not exposed to public by default)
# Grafana runs on port 3000 (for testing only; use reverse proxy in production)
# Metrics are exposed at: http://api:8000/metrics
# All services run on the same Docker network: backend_net

